# Copy this file to .env in the repository root.
# Variables already set in the operating system take precedence.
# Relative paths are resolved from the repository root.
# The Electron main process reads this file. Vite and the window do not.
# EVA_SESSION_TOKEN is generated at startup. Do not set it here.

EVA_WHISPER_EXECUTABLE=C:\Tools\whisper\whisper-cli.exe
EVA_WHISPER_MODEL=C:\Tools\whisper\ggml-base.bin
EVA_WHISPER_GPU=

EVA_KOKORO_PYTHON=C:\Tools\kokoro\venv\Scripts\python.exe
EVA_KOKORO_WORKER=speech/kokoro/worker.py
EVA_KOKORO_MODEL=C:\Tools\kokoro\kokoro-v1.0.onnx
EVA_KOKORO_VOICES=C:\Tools\kokoro\voices-v1.0.bin

EVA_OLLAMA_BASE_URL=http://127.0.0.1:11434
EVA_OPENAI_API_KEY=
