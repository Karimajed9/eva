#!/bin/sh
# Optional local check for Git for Windows, macOS, and Linux.
# Enable with: git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks is not on PATH. Install Gitleaks 8.30.1, or disable this hook with: git config --unset core.hooksPath"
  exit 1
fi
gitleaks protect --staged --redact=100 --no-banner --no-color --verbose
